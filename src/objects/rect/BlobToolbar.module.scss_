.rightHolder {
  flex-grow: 1;
}

// .inputHolder {
//   display: flex;
//   align-items: center;
//   padding: 0px 5px;
// }

.inputsHolder {
  padding-left: 10px;
  display: flex;
  align-items: center;
  // gap: 10px;

  :global {
    *,
    *:hover,
    *:focus,
    *:active {
      outline: none;
    }
  }
}

.button {
  height: 50px;
  align-items: center;
}

.squareButton {
  width: 50px !important;
}

.checkboxHolder {
  :global {
    .bp5-form-group {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      & > div {
        height: 25px;
      }
    }
  }
}

.strokeInput {
  width: 100px;
  margin-bottom: 0px;
}

.textButton {
  height: 34px !important;
  display: flex;
  align-items: center;

  :global {
    .bp5-button-text {
      height: 16px;
    }
  }
}

.colorInputHolder {
  height: 50px;
  display: flex;
  align-items: center;
}
