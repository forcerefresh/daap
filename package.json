  "private": true,
  "homepage": "./",
  "scripts": {
    "generate:types": "openapi-typescript ../daap-server/schema/openApi-schema.json -o src/types/api.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "source-map-explorer 'dist/*.js'",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
