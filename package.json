{
  "name": "web-slider",
  "version": "1.0.27",
  "author": {
    "name": "Force Refresh doo",
    "email": "support@forcerefresh.io",
    "url": "https://webslider.io"
  },
  "private": true,
  "homepage": "./",
  "main": "electron/main.js",
  "scripts": {
    "start": "yarn run start:app",
    "start:app": "env-cmd -f env/.env react-scripts start",
    "start:app:wp": "env-cmd -f env/wp.env react-scripts start",
    "start:app:electron": "cross-env BROWSER=none env-cmd -f env/electron.env react-scripts start",
    "start:main:electron": "cross-env ELECTRON_ENV=development electron .",
    "start:player": "env-cmd -f env/player-dev.env react-scripts start",
    "build:app": "react-scripts build",
    "build:app:electron": "env-cmd -f env/electron.prod.env react-scripts build",
    "build:main:electron": "env-cmd -f env/electron.prod.env webpack --config=electron-config/electron.build.webpack.js --env=production",
    "build:player": "env-cmd -f env/player.env react-scripts build",
    "bundle:player_DEL": "webpack --config bundle-player.webpack.config.js",
    "bundle:player": "gulp",
    "prebuild:native": "npm rebuild --platform=darwin --arch=arm64 sharp && npm rebuild --platform=darwin --arch=x64 sharp",
    "bb:player": "yarn run build:player && yarn run bundle:player",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "pack": "electron-builder --dir",
    "build:package:electron": "yarn run bb:player && yarn run build:app:electron && yarn run build:main:electron && electron-builder",
    "releaseapp": "yarn run prebuild:native && yarn run bb:player && yarn run build:app:electron && yarn run build:main:electron && electron-builder --publish always"
  },
  "dependencies": {
    "@blueprintjs/core": "^3.54.0",
    "@blueprintjs/popover2": "^0.10.1",
    "@reduxjs/toolkit": "^1.4.0",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.5.0",
    "@testing-library/user-event": "^7.2.1",
    "@types/classnames": "^2.2.10",
    "@types/debug": "^4.1.7",
    "@types/jest": "^24.9.1",
    "@types/lodash-es": "^4.17.3",
    "@types/node": "^12.12.67",
    "@types/react": "^16.9.52",
    "@types/react-color": "^3.0.4",
    "@types/react-dom": "^16.9.8",
    "@types/react-redux": "^7.1.9",
    "@types/trianglify": "^1.2.1",
    "@types/uuid": "^8.3.0",
    "animejs": "^3.2.1",
    "aws-sdk": "^2.1.0",
    "chalk": "4",
    "classnames": "^2.2.6",
    "clone-deep": "^4.0.1",
    "copy-to-clipboard": "^3.3.2",
    "debug": "^4.3.4",
    "deep-diff": "^1.0.2",
    "electron-reloader": "^1.2.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3",
    "env-cmd": "^10.1.0",
    "events": "^3.3.0",
    "fs-extra": "^11.1.0",
    "gsap": "file:gsap-bonus.tgz",
    "gulp-replace": "^1.1.3",
    "immutability-helper": "^3.1.1",
    "jszip": "^3.7.1",
    "keytar": "^7.8.0",
    "lodash-es": "^4.17.15",
    "mime-types": "^2.1.34",
    "node-fetch": "2",
    "node-sass": "^7.0.1",
    "react": "^16.14.0",
    "react-color": "^2.18.1",
    "react-dnd": "^15.1.1",
    "react-dnd-html5-backend": "^15.1.2",
    "react-dom": "^16.14.0",
    "react-draggable": "^4.4.3",
    "react-dropzone": "^11.5.1",
    "react-image-file-resizer": "^0.4.7",
    "react-infinite-scroll-component": "^6.1.0",
    "react-inlinesvg": "^2.3.0",
    "react-redux": "^7.2.1",
    "react-rte": "^0.16.4",
    "react-scripts": "^5.0.0",
    "react-use-error-boundary": "^2.0.1",
    "redux-devtools-extension": "^2.13.8",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.31.3",
    "source-map-explorer": "^2.5.2",
    "trianglify": "^4.1.1",
    "typescript": "^4.1.0",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "use-deep-compare-effect": "^1.5.0",
    "uuid": "^8.3.2",
    "webfontloader": "^1.6.28",
    "webpack-cli": "^4.9.2",
    "webpack-node-externals": "^3.0.0",
    "webslider-sdk": "^1.1.125",
    "write-file-atomic": "^5.0.0",
    "yt-player": "^3.5.0",
    "yup": "^0.32.11"
  },
  "resolutions": {
    "@types/react": "^16.9.52"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "devDependencies": {
    "@electron/notarize": "^1.2.3",
    "@types/animejs": "^3.1.5",
    "@types/webfontloader": "^1.6.32",
    "cross-env": "^7.0.3",
    "electron": "^15.0.0",
    "electron-builder": "^23.0.3",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-count": "^1.0.0",
    "webpack": "^5.70.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "io.webslider",
    "artifactName": "Web-Slider-App-v${version}-${arch}.${ext}",
    "productName": "WebSlider",
    "afterSign": "scripts/notarize.js",
    "mac": {
      "category": "Developer Tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": "nsis",
      "icon": "./public/icon.ico"
    },
    "linux": {
      "target": "deb"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraFiles": [
      "player-dist"
    ],
    "directories": {
      "buildResources": "public"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "forcerefresh",
        "repo": "webslider-snap"
      }
    ]
  }
}
