# NOTE: all vars have to start with REACT_APP_
VITE_APP_INTEGRATION=electron
VITE_API_URL="http://localhost:3000"
VITE_SAAS_API_URL="/api/v1"
# VITE_APP_ASSETS_BASE_URL="https://assets.webslider.io"
# VITE_APP_EXTENSIONS_BASE_URL="https://extensions.daap.forcerefresh.io"
GENERATE_SOURCEMAP=false
# Logger levels: All = 0, Trace = 10, Debug = 20, Info = 30, Notice = 40, Warn = 50, Error = 60, Fatal = 70, None = 100
# Note: For production we are allowing all levels for Objects and Animations. 
#       Reducing log level This will be controlled by Object/Animation build.
VITE_APP_LOGGER_LEVEL_APP=60
VITE_APP_LOGGER_LEVEL_PLAYER=60
VITE_APP_LOGGER_LEVEL_OBJECT=0
VITE_APP_LOGGER_LEVEL_ANIMATION=0
VITE_APP_LOGGER_LEVEL_SDK=60
VITE_APP_LOGGER_LEVEL_ELECTRON=60